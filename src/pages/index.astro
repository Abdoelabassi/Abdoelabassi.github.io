---
import MainLayout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

// You would replace this with your actual profile image
import profileImage from '../assets/abdo.jpeg';
import HyperKEventDisplay from '../components/HyperKEventDisplay.astro';

const socials = [
  { href: "https://twitter.com/aeparticle_el97", icon: "tabler:brand-x", label: "X" },
  { href: "https://bsky.app/profile/aeparticle.bsky.social", icon: "tabler:brand-bluesky", label: "Bluesky" },
  { href: "https://medium.com/@aelabassi", icon: "simple-icons:medium", label: "Medium" },
  { href: "https://linkedin.com/in/el-abassi-abderrazaq", icon: "tabler:brand-linkedin", label: "LinkedIn" },
  { href: "https://github.com/Abdoelabassi", icon: "tabler:brand-github", label: "GitHub" },
  { href: "https://www.kaggle.com/elabbassiabderezzaq", icon: "simple-icons:kaggle", label: "Kaggle" },
  { href: "https://scholar.google.fr/citations?hl=fr&user=ltigocIAAAAJ", icon: "simple-icons:googlescholar", label: "Google Scholar" },
  { href: "https://orcid.org/my-orcid?orcid=0009-0002-0516-9465", icon: "simple-icons:orcid", label: "Orcid" },
  { href: "https://www.researchgate.net/profile/El-Abassi-Abderrazaq", icon: "simple-icons:researchgate", label: "ResearchGate" },
];

const interests = [
  "Neutrino oscillation, astrophysical neutrinos, and dark matter",
  "Detector calibration and software analysis",
  "LHC physics",
  "Machine learning and deep learning for particle reconstruction",
  "Quantum Computing",
  "Science Communication",
];

const education = [
  { degree: "PhD in Particle Physics, 2021 - present", school: "University Ibn Tofail - Kenitra" },
  { degree: "MSc in Mathematical Physics, 2018 - 2020", school: "Mohammed V University - Rabat" },
  { degree: "Bachelor/Licence in Physics, 2015 - 2018", school: "University Moulay Ismail - Meknes" },
];
---

<MainLayout title="EL Abassi Abderrazaq - Academic Researcher" backdrop={false}>
  <!-- Hero: a simulated Hyper-Kamiokande event display as the background -->
  <section class="hero relative isolate overflow-hidden">
    <!-- Event display -->
    <div class="absolute inset-x-0 top-[92px] h-[300px] sm:top-0 sm:h-[440px] lg:inset-y-0 lg:left-[36%] lg:right-0 lg:h-auto -z-20">
      <div class="absolute inset-0 hk-glow"></div>
      <HyperKEventDisplay />
    </div>

    <!-- Readability scrims (page colour → transparent) -->
    <div class="hero-scrim pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

    <!-- Event-display HUD -->
    <div class="pointer-events-none absolute z-0 left-4 right-4 top-3 sm:left-auto sm:right-4 sm:top-4 lg:right-8 lg:top-auto lg:bottom-8 sm:w-60 font-mono text-[10px] leading-relaxed text-gray-600 dark:text-gray-300" aria-hidden="true">
      <div class="rounded-lg border border-gray-900/10 bg-white/60 px-3 py-2.5 backdrop-blur-md dark:border-white/10 dark:bg-gray-950/50">
        <p class="font-semibold uppercase tracking-[0.18em] text-gray-900 dark:text-white">Hyper-Kamiokande</p>
        <p class="hidden sm:block text-gray-500 dark:text-gray-400">Inner detector · Ø 68 m × 71 m</p>
        <div class="mt-2 hidden lg:block">
          <canvas data-hk-unrolled class="block w-full aspect-[214/215]"></canvas>
          <p class="mt-0.5 text-center text-[9px] uppercase tracking-wider text-gray-400">unrolled: top cap · barrel · bottom cap</p>
        </div>
        <div class="mt-2 hidden sm:grid grid-cols-[auto_1fr] gap-x-3">
          <span class="text-gray-400">event</span><span>upward-stopping μ (sim.)</span>
          <span class="text-gray-400">θ<sub>c</sub></span><span><span data-hk-theta>41.7°</span> · n = 1.34</span>
          <span class="text-gray-400">hit PMTs</span><span data-hk-hits>—</span>
          <span class="text-gray-400">Δt</span><span data-hk-span>—</span>
        </div>
        <p class="mt-1 sm:hidden">upward-stopping μ · θ<sub>c</sub> ≈ 42°</p>
        <div class="mt-2.5">
          <div class="h-1.5 rounded-full hk-scale"></div>
          <div class="mt-1 flex justify-between text-[9px] uppercase tracking-wider text-gray-400">
            <span>early</span><span>hit time</span><span>late</span>
          </div>
        </div>
        <p class="mt-1 hidden sm:block text-[9px] text-gray-400">dot size ∝ charge · toy MC, illustrative</p>
      </div>
    </div>

    <div class="container mx-auto px-4 max-w-6xl relative z-10">
      <div class="max-w-xl pt-[340px] sm:pt-[380px] lg:pt-24 pb-16 lg:pb-28 lg:min-h-[640px] animate-rise">
        <div class="flex items-center gap-4 mb-6">
          <div class="relative h-16 w-16 sm:h-20 sm:w-20 shrink-0 rounded-full bg-[conic-gradient(from_200deg,#2d74ff,#33d6ff,#2d74ff00_55%,#2d74ff)] p-[2px] shadow-[0_0_40px_-8px_rgb(45_116_255/0.6)]">
            <div class="h-full w-full overflow-hidden rounded-full bg-gray-900">
              <img
                src={"/images/abdo.jpeg"}
                alt="Profile photo"
                width={80}
                height={80}
                class="w-full h-full object-cover"
              />
            </div>
          </div>
          <p class="eyebrow flex items-center gap-3">
            <span class="inline-block h-px w-8 bg-current"></span>
            PhD student in Particle Physics
          </p>
        </div>
        <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl font-bold leading-[0.95] tracking-tight text-gray-950 dark:text-white">
          EL Abassi<br />
          <span class="glow-text">Abderrazaq</span>
        </h1>

        <div class="mt-8 max-w-xl text-lg leading-relaxed text-gray-600 dark:text-gray-300">
          <h2 class="sr-only">About me</h2>
          <p>I'm Abderrazaq EL Abassi, a PhD student in Particle Physics at the University of Ibn Tofail, Kenitra.
            I'm working under the supervision of <a href="https://www.researchgate.net/profile/Mohamed-Gouighri" class="font-medium text-emerald-600 underline decoration-emerald-400/40 underline-offset-4 hover:decoration-emerald-500 dark:text-emerald-400">Prof. Mohamed Gouighri</a>.</p>
        </div>

        <div class="mt-8 flex flex-col gap-1.5 text-sm">
          <a href="https://ped.uit.ac.ma/laboratoire-physique-des-materiaux-et-subatomique/" class="group inline-flex items-center gap-2 text-gray-700 hover:text-emerald-600 dark:text-gray-300 dark:hover:text-emerald-400">
            <Icon name="tabler:atom-2" class="h-4 w-4 shrink-0 text-emerald-500" />
            <span class="group-hover:underline underline-offset-4">Laboratoire de Physique des Matériaux et Subatomique</span>
          </a>
          <a href="#" class="group inline-flex items-center gap-2 text-gray-700 hover:text-emerald-600 dark:text-gray-300 dark:hover:text-emerald-400">
            <Icon name="tabler:building-community" class="h-4 w-4 shrink-0 text-emerald-500" />
            <span class="group-hover:underline underline-offset-4">Departement of Physics</span>
          </a>
          <a href="https://fs.uit.ac.ma" class="group inline-flex items-center gap-2 text-gray-700 hover:text-emerald-600 dark:text-gray-300 dark:hover:text-emerald-400">
            <Icon name="tabler:school" class="h-4 w-4 shrink-0 text-emerald-500" />
            <span class="group-hover:underline underline-offset-4">University of Ibn Tofail, Kenitra</span>
          </a>
        </div>

        <div class="mt-10 flex flex-wrap gap-2">
          {socials.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              title={s.label}
              class="grid h-10 w-10 place-items-center rounded-full border border-gray-200 bg-white/70 text-gray-600 backdrop-blur-sm transition-all hover:-translate-y-0.5 hover:border-emerald-400 hover:text-emerald-600 hover:shadow-[0_8px_24px_-10px_rgb(45_116_255/0.8)] dark:border-white/10 dark:bg-gray-950/40 dark:text-gray-300 dark:hover:text-emerald-300"
            >
              <Icon name={s.icon} class="w-[18px] h-[18px]" />
              <span class="sr-only">{s.label}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <style>
    .hk-glow {
      background: radial-gradient(ellipse 60% 55% at 50% 45%, rgb(45 116 255 / 0.16), transparent 70%);
    }
    .hk-scale {
      background: linear-gradient(90deg, #2d74ff 0%, #33d6ff 30%, #6ef0a0 55%, #ffc85a 78%, #ff5440 100%);
    }
    /* Mobile: fade the display out under the text */
    .hero-scrim {
      background: linear-gradient(180deg, transparent 0, transparent 300px, var(--page-bg) 395px);
    }
    @media (min-width: 640px) {
      .hero-scrim {
        background: linear-gradient(180deg, transparent 0, transparent 250px, var(--page-bg) 410px);
      }
    }
    /* Desktop: fade from the text column into the detector */
    @media (min-width: 1024px) {
      .hero-scrim {
        background:
          linear-gradient(90deg, var(--page-bg) 0%, var(--page-bg) 34%, color-mix(in srgb, var(--page-bg) 70%, transparent) 46%, transparent 62%),
          linear-gradient(0deg, var(--page-bg) 0%, transparent 18%);
      }
    }
  </style>

  <div class="container mx-auto px-4 max-w-6xl">
    <!-- Interests + Education -->
    <section class="grid md:grid-cols-2 gap-6">
      <div class="surface p-7 sm:p-8">
        <p class="eyebrow">01 — Research</p>
        <h3 class="mt-2 text-2xl font-bold text-gray-950 dark:text-white">Interests</h3>
        <ul class="mt-6 space-y-3">
          {interests.map((item) => (
            <li class="flex gap-3 text-gray-700 dark:text-gray-300">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-500 shadow-[0_0_8px_2px_rgb(45_116_255/0.5)]"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="surface p-7 sm:p-8">
        <p class="eyebrow">02 — Path</p>
        <h3 class="mt-2 text-2xl font-bold text-gray-950 dark:text-white">Education</h3>
        <ol class="mt-6 relative border-l border-gray-200 dark:border-white/10 ml-2 space-y-6">
          {education.map((e, i) => (
            <li class="pl-6 relative">
              <span class={`absolute -left-[7px] top-1.5 h-3 w-3 rounded-full ring-4 ring-[var(--page-bg)] ${i === 0 ? 'bg-emerald-500' : 'bg-gray-300 dark:bg-gray-600'}`}></span>
              <div class="flex items-center gap-2">
                <Icon name="tabler:school" class="w-4 h-4 shrink-0 text-emerald-600 dark:text-emerald-400" />
                <span class="font-medium text-gray-900 dark:text-gray-100">{e.degree}</span>
              </div>
              <p class="text-gray-600 dark:text-gray-400 mt-0.5">{e.school}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  </div>
</MainLayout>
